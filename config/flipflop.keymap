#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ---------------------------------------------------------------------------------
            // |   `  |  1  |  2  |  3  |  4  |  5  |     |  6  |  7  |  8  |  9  |  0  | BKSP |
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |     |  Y  |  U  |  I  |  O  |  P  |  \   |
            // | CAPS |  A  |  S  |  D  |  F  |  G  |     |  H  |  J  |  K  |  L  |  ;  |  ENT |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |     |  N  |  M  |  ,  |  .  |  /  | APOS |
            //              | GUI | SPC | SPC | SPC |     | SPC | LOW |LARW |DARW |

            bindings = <
&kp NON_US_BACKSLASH  &kp N1  &kp N2    &kp N3    &kp N4     &kp N5    &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp BSPC
&kp TAB               &kp Q   &kp W     &kp E     &kp R      &kp T     &kp Y   &kp U   &kp I      &kp O    &kp P     &kp BSLH
&kp CAPS              &kp A   &kp S     &kp D     &kp F      &kp G     &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp APOS
&kp LSHFT             &kp Z   &kp X     &kp C     &kp V      &kp B     &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp ENTER
                              &kp LALT  &kp LGUI  &kp SPACE  &mo 1     &kp A   &kp B   &kp C      &kp D
            >;
        };

        layer_1 {
            bindings = <
&kp ESC  &trans     &trans     &trans    &trans          &trans    &kp C_PREV          &kp C_PLAY          &kp LA(C_NEXT)    &kp K_MUTE           &kp C_VOLUME_DOWN  &kp C_VOL_UP
&trans   &kp EQUAL  &kp MINUS  &kp PLUS  &kp UNDERSCORE  &trans    &kp LA(LEFT_ARROW)  &kp LA(DOWN_ARROW)  &kp LA(UP_ARROW)  &kp LA(RIGHT_ARROW)  &trans             &trans
&trans   &trans     &trans     &trans    &trans          &trans    &kp LEFT_ARROW      &kp DOWN_ARROW      &kp UP_ARROW      &kp RIGHT_ARROW      &trans             &trans
&trans   &trans     &trans     &trans    &trans          &trans    &kp RG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(UP_ARROW)  &kp LG(RIGHT_ARROW)  &trans             &trans
                    &trans     &trans    &trans          &trans    &trans              &trans              &trans            &trans
            >;
        };
    };
};
